---
import Base from '../layouts/Base.astro';
import Ausweis from '../components/Ausweis.astro';
import Mark from '../components/Mark.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stream from '../components/Stream.astro';
import { featured } from '../data/projects';
---

<Base path="/">
  <section class="hero" aria-labelledby="intro">
    <div>
      <h1 id="intro" class="hero-prose">
        <strong>Hallo, ich bin Sebastian.</strong>{' '}
        Softwareentwickler in Wien, tagsüber bei <a href="https://www.sens.at">sens.at</a>.{' '}
        <strong>Abends baue ich <Mark href="https://clunema.com" icon="/marken/clunema.png" label="Clunema" />,</strong>{' '}
        eine Vereinssoftware mit Kassa, die bald auf den Markt kommt.{' '}
        <strong>Fast alles davor ist entstanden, <em>weil ein Werkzeug gefehlt hat:</em></strong>{' '}
        <Mark href="https://github.com/realS3BI/playbook" icon="/marken/playbook.svg" label="Playbook" />, damit mein
        CS2-Team Granaten üben kann, und{' '}
        <Mark href="https://reals3bi.github.io/vnc-beach/" icon="/marken/vnc-beach.png" label="VNC Beach" />, weil ich
        einen VNC-Client wollte, der nichts kostet.
      </h1>
      <div class="hero-actions">
        <a class="btn" href="#kontakt">Schreib mir <span aria-hidden="true">→</span></a>
        <a class="quiet" href="https://github.com/realS3BI">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <Stream />
  </section>

  <section id="projekte" class="section" aria-labelledby="projekte-titel" data-reveal>
    <div class="section-head">
      <h2 id="projekte-titel" class="section-title">Ausgewählte Projekte</h2>
      <a class="quiet" href="/projekte">alle Projekte <span aria-hidden="true">→</span></a>
    </div>
    <ul class="cards three">
      {featured.map((p) => <ProjectCard project={p} />)}
    </ul>
  </section>

  <section id="ueber-mich" class="section" aria-labelledby="ueber-titel" data-reveal>
    <div class="section-head">
      <h2 id="ueber-titel" class="section-title">Über mich</h2>
    </div>
    <div class="about">
      <Ausweis />
      <div class="about-text">
        <p>
          Ich schreibe Software meistens dann, wenn mir oder Leuten um mich herum ein Werkzeug fehlt. So ist ein
          Trainingsserver für das CS2-Team entstanden, eine Kasse für den Verein und ein VNC-Client in Rust.
        </p>
        <p>
          Am liebsten arbeite ich mit TypeScript, React und Convex. Wenn es schnell und nah am System sein muss, mit
          Rust. Auf GitHub seit 2020, als <a href="https://github.com/realS3BI">realS3BI</a>.
        </p>
        <dl class="tools">
          <div>
            <dt>Sprachen</dt>
            <dd>TypeScript, Rust, C#, Python</dd>
          </div>
          <div>
            <dt>Oberflächen</dt>
            <dd>React, Next.js, Astro, Tailwind CSS</dd>
          </div>
          <div>
            <dt>Daten und Betrieb</dt>
            <dd>Convex, MongoDB, Postgres, Docker, Tailscale</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="kontakt" class="section contact" aria-labelledby="kontakt-titel" data-reveal>
    <div class="section-head">
      <h2 id="kontakt-titel" class="section-title">Kontakt</h2>
    </div>
    <p>Eine Idee, ein Projekt oder eine Frage?</p>
    <a class="contact-mail" href="mailto:sebastian@schlossers.at">sebastian@schlossers.at</a>
    <div class="contact-links">
      <a class="quiet" href="https://github.com/realS3BI">GitHub <span aria-hidden="true">↗</span></a>
      <a class="quiet" href="https://www.linkedin.com/in/sebastian-schlosser">LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
