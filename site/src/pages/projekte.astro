---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projekte · Sebastian Schlosser"
  description="Alle Projekte von Sebastian Schlosser: Clunema, Playbook, VNC Beach, vaultship, dns-manager und der Music & AI Hackathon."
  path="/projekte"
>
  <div class="page-head">
    <h1 class="page-title">Projekte</h1>
    <p>
      Jedes dieser Werkzeuge ist aus einem konkreten Mangel heraus entstanden. Der Code liegt auf GitHub, zwei davon
      laufen auch als fertige Produkte.
    </p>
  </div>
  <ul class="cards">
    {projects.map((p) => <ProjectCard project={p} sizes="(min-width: 40rem) 32rem, 92vw" showTech />)}
  </ul>
</Base>
