---
import ThemeToggle from './ThemeToggle.astro';
import { other, routes, ui, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route?: RouteKey;
}

const { lang, route } = Astro.props;
const s = ui[lang];
const o = other(lang);
const home = routes.home[lang];
const altHref = route ? routes[route][o] : routes.home[o];
---

<header class="site-header wrap">
  <a class="brand" href={home}>
    <img src="/avatar.png" alt="" width="28" height="28" />
    <span>schlossers.at</span>
  </a>
  <nav class="nav" aria-label={s.navLabel}>
    <ul>
      <li>
        <a href={routes.projects[lang]} aria-current={route === 'projects' ? 'page' : undefined}>{s.nav.projects}</a>
      </li>
      <li><a href={`${home}#about`}>{s.nav.about}</a></li>
      <li><a href={`${home}#contact`}>{s.nav.contact}</a></li>
    </ul>
    <a class="lang" href={altHref} hreflang={o} lang={o} data-set-lang={o} aria-label={s.switchLang}>
      {o.toUpperCase()}
    </a>
    <ThemeToggle label={s.theme} />
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', link.dataset.setLang ?? 'de');
      } catch {}
    });
  });
</script>
