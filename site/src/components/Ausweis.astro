---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang].card;
---

<aside class="ausweis" aria-label={s.label}>
  <div class="ausweis-head eyebrow">
    <span>{s.title}</span>
    <span>{s.number}</span>
  </div>
  <div class="ausweis-id">
    <img src="/avatar.jpg" alt={s.avatarAlt} width="88" height="88" />
    <div>
      <p class="ausweis-name">Sebastian Schlosser</p>
      <p class="ausweis-role">{s.role}</p>
    </div>
  </div>
  <dl>
    <div><dt>{s.since}</dt><dd>2020</dd></div>
    <div><dt>{s.byDay}</dt><dd>sens.at</dd></div>
    <div><dt>{s.building}</dt><dd>Clunema</dd></div>
  </dl>
</aside>
